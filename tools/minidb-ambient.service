[Unit]
Description=minidb ambient load sampler (append-only loadavg log for capture scheduling)
Documentation=file:///home/grub/projects/minidb/tools/ambient_map.py
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/grub/projects/minidb
ExecStart=/usr/bin/python3 /home/grub/projects/minidb/tools/ambient_map.py --sample --interval 5 --log /home/grub/.minidb-ambient.jsonl
Restart=always
RestartSec=10
# A sampler that dies silently is worse than no sampler: the log keeps looking current to anyone who
# does not stat it. Restart=always plus the tool's own stale= stamp are the two halves of that guard.

[Install]
WantedBy=default.target
